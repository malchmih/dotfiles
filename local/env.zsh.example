# Optional machine-local environment, loaded by every Zsh (including zsh -c).
# Keep this file quiet and lightweight: no aliases, prompts, or tool initialization.
# Set XDG_CONFIG_HOME before starting Zsh if you use a nondefault config directory.
# Example additions (uncomment and adapt only if needed):
# export EDITOR=vi
# path+=("$HOME/tools/bin")
# For an existing standalone OpenCode install only (check command ownership first):
# path=("$HOME/.local/bin" "$HOME/.opencode/bin" $path)
