#!/usr/bin/env bash

# Explicit optional setup; never called by core recovery or shell startup.
set -euo pipefail

die() {
    printf 'setup-toolchains: %s\n' "$*" >&2
    exit 1
}

case "${1:-}" in
    '') ;;
    --help|-h)
        printf '%s\n' 'Usage: ./setup-toolchains' \
            'Require standalone mise, install missing Homebrew uv, and select latest stable personal Node, Java, and CPython.' \
            'Rerunning deliberately refreshes these floating global requests; projects are not edited.' \
            'See docs/toolchains.md for ownership, trust, and verification.'
        exit 0
        ;;
    *) die "Unknown option: $1. Use --help." ;;
esac
[[ $# -eq 0 ]] || die 'Expected no arguments. Use --help.'

case "$(uname -s)" in
    Darwin) ;;
    Linux)
        [[ -r /etc/os-release ]] || die 'Cannot identify Linux; expected Ubuntu or Debian.'
        # shellcheck source=/dev/null
        . /etc/os-release
        case "${ID:-}" in
            ubuntu|debian) ;;
            *) die 'Only macOS and Ubuntu/Debian desktop or WSL Linux are supported.' ;;
        esac
        ;;
    *) die 'Only macOS and Ubuntu/Debian desktop or WSL Linux are supported.' ;;
esac
[[ $EUID -ne 0 ]] || die 'Run as your ordinary user, not with sudo.'
mise="$HOME/.local/bin/mise"
[[ -f "$mise" && -x "$mise" && ! -L "$mise" ]] ||
    die 'Official standalone mise must be a regular executable at ~/.local/bin/mise; see docs/toolchains.md.'
actual_mise="$(command -v mise || true)"
[[ -n "$actual_mise" && "$actual_mise" -ef "$mise" ]] ||
    die 'Standalone mise at ~/.local/bin/mise must be first on PATH; see docs/toolchains.md.'
command -v brew >/dev/null || die 'Homebrew must be on PATH; see docs/core-tools.md.'
brew_prefix="$(brew --prefix)"

export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_INSTALL_CLEANUP=1
export HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1

# Refuse visible competing uv owners before installing anything, including uvx.
# mise uses the official standalone default path; uv remains Homebrew-owned.
for tool in uv uvx; do
    actual="$(command -v "$tool" || true)"
    expected="$brew_prefix/bin/$tool"
    if [[ -n "$actual" && ! "$actual" -ef "$expected" ]]; then
        die "Competing $tool on PATH: $actual. Inspect ownership/PATH yourself; see docs/toolchains.md."
    fi
done

if brew list --formula --versions uv >/dev/null 2>&1; then
    printf 'Present (Homebrew): uv\n'
else
    printf 'Missing (Homebrew): uv\n'
    brew install --formula uv || die 'Homebrew installation failed; inspect the error and rerun.'
fi
brew tab --installed-on-request --formula uv || die 'Could not record explicit Homebrew ownership.'
for tool in uv uvx; do
    actual="$(command -v "$tool" || true)"
    [[ -n "$actual" && "$actual" -ef "$brew_prefix/bin/$tool" ]] ||
        die "Selected $tool is not on PATH. Fix Homebrew linking/PATH, then rerun."
done

# Work outside the caller's project. Remove only the legacy overrides so mise's
# normal global defaults apply, preserving unrelated settings and tool entries.
cd "$HOME"
"$mise" settings unset auto_install
"$mise" settings unset not_found_system_fallback
"$mise" settings unset upgrade.auto_prune
# Resolve fresh stable releases, even if an older matching version is installed.
# --fuzzy keeps the requests floating even when the user's pin setting is enabled.
MISE_PRERELEASES=false MISE_FETCH_REMOTE_VERSIONS_CACHE=0s \
    "$mise" use --global --fuzzy node@latest java@latest python@latest
# Verify the selected executables without letting these checks install anything.
MISE_AUTO_INSTALL=false "$mise" exec -- node --version
MISE_AUTO_INSTALL=false "$mise" exec -- java -version
MISE_AUTO_INSTALL=false "$mise" exec -- javac -version
MISE_AUTO_INSTALL=false "$mise" exec -- python --version
"$brew_prefix/bin/uv" --version
printf '%s\n' 'Personal floating latest requests selected. Apply reviewed shared configuration with mise dot apply from the checkout, then open a fresh terminal.' \
    'Existing Python installations, environments, and pipx applications are unchanged. See docs/toolchains.md for project/IDE use.'
